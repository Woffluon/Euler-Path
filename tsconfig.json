{
  "compilerOptions": {
    "target": "ES2021",
    "module": "ESNext",
    "lib": ["ES2021", "DOM"],
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "skipLibCheck": true,
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": false,
    "noImplicitAny": false,
    "baseUrl": ".",
    "paths": {
      "@/*": ["js/*"],
      "@core/*": ["js/core/*"],
      "@screens/*": ["js/screens/*"],
      "@data/*": ["js/data/*"],
      "@utils/*": ["js/utils/*"]
    }
  },
  "include": ["js/**/*"],
  "exclude": ["node_modules", "dist"]
}
