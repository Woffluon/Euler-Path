# Environment Variables Example
# Copy this file to .env.development or .env.production and update values
# All variables must be prefixed with VITE_ to be exposed to the client

# Application name displayed in the UI and browser title
# Used in: App initialization, page title
VITE_APP_NAME="Euler's Path"

# API URL for backend services (reserved for future use)
# Currently unused but available for future backend integration
# Development: http://localhost:5173
# Production: https://your-api-domain.com
VITE_API_URL=http://localhost:5173

# Enable debug mode for detailed error messages and console logs
# When true: Shows detailed error messages, enables console.log statements
# When false: Shows generic error messages, console.log removed in production build
# Development: true (recommended)
# Production: false (recommended)
VITE_DEBUG=false
