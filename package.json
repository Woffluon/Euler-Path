{
  "name": "eulerin-yolu-vanilla",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:analyze": "vite build && open dist/stats.html",
    "preview": "vite preview",
    "preview:dist": "vite preview --port 4173",
    "lint": "eslint . --ext .js",
    "lint:fix": "eslint . --ext .js --fix",
    "format": "prettier --write \"**/*.{js,json,css,html,md}\"",
    "format:check": "prettier --check \"**/*.{js,json,css,html,md}\"",
    "type-check": "tsc --noEmit",
    "optimize:svg": "svgo --config svgo.config.js --folder public/svgs --recursive",
    "clean": "rimraf dist node_modules/.vite",
    "clean:all": "rimraf dist node_modules",
    "deploy": "npm run build && echo 'Build complete. Deploy dist/ to your hosting platform.'",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "prettier": "^3.8.1",
    "rimraf": "^6.1.3",
    "rollup-plugin-visualizer": "^6.0.5",
    "svgo": "^4.0.0",
    "terser": "^5.46.0",
    "typescript": "^5.9.3",
    "vite": "^5.2.0"
  },
  "dependencies": {
    "lucide-static": "^0.378.0"
  }
}
